# ==============================================================================
# SECURE AUTHENTICATION LAB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific secrets.
# NEVER commit the actual '.env' file to version control.

# Flask Application Environment
FLASK_ENV=development
FLASK_DEBUG=False

# Cryptographic Session Secret Key
# Generate a strong key in production using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production

# Secure Session Cookie Settings
# Set SESSION_COOKIE_SECURE to True in production environments when serving over HTTPS/TLS
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Session Expiration (in minutes)
PERMANENT_SESSION_LIFETIME_MINUTES=30

# Rate Limiting Configuration
# Development default uses in-memory tracking. Production should use Redis ('redis://localhost:6379/0')
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200/day;50/hour
